# kifs configuration.
#
# Session cookies live in Infisical (project "Kifs", env prod) and are fetched
# automatically using the INFISICAL_KIFS_* machine identity in ~/.env.global.
# Set them here only to override Infisical, or when running with --no-infisical.
#
# WEB_SESSION=          # shogiwars.heroz.jp Rails session
# ANALYTICS_SESSION=    # kishin-analytics.heroz.jp Django sessionid

# Where the dataset lives. Everything else is derived from it.
# KIFS_DATA_DIR=/home/user/kifs-data

# Crawl behaviour
# KIFS_GAME_TYPES=sb            # comma separated, e.g. sb,s1
# KIFS_USER_RECRAWL_HOURS=24    # how long before a crawled user is revisited
# KIFS_MAX_HISTORY_PAGES=20     # cap on history pages per user per game type
# KIFS_REQUEST_DELAY=1.5        # polite delay between requests, seconds
# KIFS_KIF_RETRY_BASE_MINUTES=30
# KIFS_KIF_MAX_ATTEMPTS=12
# KIFS_FLUSH_EVERY_WRITES=200   # database flush thresholds
# KIFS_FLUSH_EVERY_SECONDS=60
